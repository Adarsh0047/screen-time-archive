<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DAYTRACE"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_refresh_background"
            android:contentDescription="@string/widget_refresh"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_refresh"
            />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="No data yet"
        android:textColor="@color/widget_primary"
        android:textSize="34sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/widget_track"
        android:progressTint="@color/widget_accent" />

    <TextView
        android:id="@+id/widget_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0% of 6h 0m"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/widget_apps"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_app_1" style="@style/WidgetAppRow" />
        <TextView android:id="@+id/widget_app_2" style="@style/WidgetAppRow" />
        <TextView android:id="@+id/widget_app_3" style="@style/WidgetAppRow" />
        <TextView android:id="@+id/widget_app_4" style="@style/WidgetAppRow" />
        <TextView android:id="@+id/widget_app_5" style="@style/WidgetAppRow" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="● Never synced"
        android:textColor="@color/widget_secondary"
        android:textSize="11sp" />
</LinearLayout>
