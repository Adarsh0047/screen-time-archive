<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DAYTRACE"
            android:textColor="#FF40D9F4"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_refresh_background"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFBDF5FF"
            android:textSize="25sp"
            android:contentDescription="Refresh Daytrace" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="No data yet"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#FF1A505D"
        android:progressTint="#FF40D9F4" />

    <TextView
        android:id="@+id/widget_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0% of 6h 0m"
        android:textColor="#FF9EDCE8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_app_1" style="@style/WidgetAppRow" />
        <TextView android:id="@+id/widget_app_2" style="@style/WidgetAppRow" />
        <TextView android:id="@+id/widget_app_3" style="@style/WidgetAppRow" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● Never synced"
        android:textColor="#FF8CCAD6"
        android:textSize="11sp" />
</LinearLayout>
